<Window x:Class="ParserApp.MappingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Маппинг полей" Height="560" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Путь к списку элементов в ответе API"
                   FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1"
                   Text="Например 'data' или 'results.items'. Оставь пустым, чтобы парсер сам нашёл список в ответе."
                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"/>
        <TextBox Grid.Row="2" x:Name="TxtItemsPath" Margin="0,0,0,12"/>

        <Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" Padding="8" Margin="0,0,0,10" Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="Импорт готового маппинга от нейросети" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6">
                    Вставьте сюда JSON-ответ LLM вида {"items_path":"data","mapping":{"id":"id","title":"attributes.name"}} — или просто {"id":"id","title":"attributes.name"} без items_path — и нажмите "Импортировать". Заменит поля ниже.
                </TextBlock>
                <TextBox x:Name="TxtImportJson" Height="70" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="BtnImport" Content="Импортировать" Width="120" Click="BtnImport_Click"/>
                    <TextBlock x:Name="LblImportStatus" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Маппинг полей (нормализация)" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,0,0,6"
                       Text="Каждая строка: выходное имя поля (как будет в базе) -> путь до значения внутри ОДНОГО элемента списка, через точку (например attributes.price.value). Можно редактировать вручную или импортировать из JSON выше."/>

            <DataGrid Grid.Row="2" x:Name="DgMapping" AutoGenerateColumns="False"
                      CanUserAddRows="False" AlternatingRowBackground="#F5F5F5">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Выходное поле" Binding="{Binding OutputField, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Путь в JSON элемента" Binding="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnAddRow" Content="+ Добавить поле" Width="140" Click="BtnAddRow_Click"/>
            <Button x:Name="BtnRemoveRow" Content="Удалить выбранное" Width="150" Margin="10,0,0,0" Click="BtnRemoveRow_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="Отмена" Width="90" Click="BtnCancel_Click"/>
            <Button x:Name="BtnSave" Content="Сохранить" Width="90" Margin="10,0,0,0" IsDefault="True" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
