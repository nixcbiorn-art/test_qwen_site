# Пример файла конфигурации через переменные окружения
# Скопируйте этот файл в .env и заполните актуальными значениями

# Базовые URL
PARSER_SITE_URL=https://example.com
PARSER_API_BASE_URL=https://api.example.com/v1

# Учетные данные
PARSER_USERNAME=your_username
PARSER_PASSWORD=your_password

# Настройки мониторинга
PARSER_CHECK_INTERVAL=300
PARSER_HEADLESS=true

# Настройки браузера
PARSER_BROWSER_TYPE=chromium

# Настройки краулера
PARSER_CRAWL_MAX_PAGES=200
PARSER_CRAWL_DELAY=1.0
PARSER_CRAWL_INCLUDE_QUERY=false
